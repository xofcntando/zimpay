<%- include('_head') %>
<form class="card" method="post" action="/withdraw">
  <h2>Withdraw</h2>
  <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="key" value="<%= key %>">
  <label>Pay out to EcoCash number<input name="msisdn" inputmode="tel" value="<%= user.phone %>" required></label>
  <div class="row">
    <label>Amount<input name="amount" inputmode="decimal" required></label>
    <label>Currency<select name="currency"><option>USD</option><option>ZWG</option></select></label>
  </div>
  <p class="muted">Fee: <%= cfg.feeBps.cashout / 100 %>%. Requires ID verification.</p>
  <button class="btn">Request withdrawal</button>
</form>
<%- include('_foot') %>
